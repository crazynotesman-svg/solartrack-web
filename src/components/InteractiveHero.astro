---
// ---------------------------------------------------------------------------
// InteractiveHero — 可拖拽太阳(环境光) + 真实 App 截图手机
// 太阳位置 → 注入 CSS 变量 → 驱动背景光晕 + 手机阴影，营造"用光塑形"的互动
// ---------------------------------------------------------------------------
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { getAppStoreUrl } from '../lib/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const appStoreUrl = getAppStoreUrl(lang);
---

<section class="relative">
	<!-- 顶部文案（SEO 主标题） -->
	<div class="relative z-10 mx-auto max-w-3xl px-4 pt-16 pb-4 text-center sm:pt-24">
		<span
			class="mb-6 inline-flex items-center gap-2 rounded-full border border-line px-4 py-1.5 text-xs font-medium text-ink/80"
		>
			<span class="h-1.5 w-1.5 rounded-full" style="background-color: var(--sun-color)"></span>
			{t('hero.badge')}
		</span>
		<h1 class="text-4xl font-bold leading-tight tracking-tight text-ink sm:text-6xl">
			{t('hero.title')}
		</h1>
		<p class="mt-5 text-base leading-relaxed text-ink/70 sm:text-lg">{t('hero.subtitle')}</p>
		<div class="mt-8 flex flex-col items-center gap-3" id="download">
			<a
				href={appStoreUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 rounded-full px-8 py-3.5 text-base font-semibold text-white shadow-lg transition-transform hover:scale-[1.03]"
				style="background-color: var(--sun-color)"
			>
				<!-- App Store 图标 -->
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
				</svg>
				{t('hero.cta')}
			</a>
			<span class="text-xs text-ink/60">{t('hero.cta.sub')}</span>
		</div>
	</div>

	<!-- 交互画布：太阳(环境光) + 真实 App 截图手机 -->
	<div
		id="sky-container"
		class="relative mt-4 flex h-[78vh] w-full items-center justify-center overflow-hidden"
	>
		<!-- 深色渐变底（随主题背景色），增强暗色质感 -->
		<div
			class="pointer-events-none absolute inset-0"
			style="background: radial-gradient(120% 80% at 50% 0%, color-mix(in srgb, var(--sun-color) 10%, transparent), transparent 60%)"
			aria-hidden="true"
		></div>

		<!-- 太阳驱动的环境光晕（位置随 --sun-x/-y 移动） -->
		<div
			id="sun-glow"
			class="pointer-events-none absolute inset-0"
			aria-hidden="true"
		></div>

		<!-- 可拖拽太阳 -->
		<div
			id="draggable-sun"
			class="absolute z-30 h-20 w-20 cursor-grab rounded-full"
			role="slider"
			aria-label="Sun position"
			aria-valuemin="0"
			aria-valuemax="100"
		></div>

		<!-- 手机舞台：真实 App 截图（仅保留主屏，无重叠副屏） -->
		<div class="relative z-20 flex items-center justify-center">
			<!-- 主屏背后的柔和光晕，强化暗色质感（非手机，纯装饰） -->
			<div
				class="pointer-events-none absolute left-1/2 top-1/2 h-[340px] w-[340px] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-60 blur-3xl"
				style="background: radial-gradient(circle, color-mix(in srgb, var(--sun-color) 22%, transparent), transparent 70%)"
				aria-hidden="true"
			></div>

			<!-- 主屏（Today） -->
			<div
				id="mockup-object"
				class="relative w-[260px] rounded-[2.4rem] border border-line bg-black p-2 shadow-[0_40px_80px_-30px_rgba(0,0,0,0.9)] sm:w-[300px]"
			>
				<img
					src="/shots/1.webp"
					alt={t('education.imageAlt')}
					class="w-full rounded-[2rem]"
					loading="eager"
					decoding="async"
				/>
			</div>
		</div>

		<!-- 拖拽提示 -->
		<p
			class="absolute bottom-6 left-1/2 z-20 -translate-x-1/2 whitespace-nowrap text-xs text-ink/50"
			id="drag-hint"
		>
			☀ {t('hero.dragHint')}
		</p>
	</div>

	<!-- 今日太阳：真实计算读数（客户端按位置计算，无 JS 时显示占位） -->
	<div
		id="sun-readout"
		class="relative z-20 mx-auto mt-10 flex w-full max-w-md flex-col items-center gap-4 rounded-2xl border border-line bg-card/60 px-5 py-4"
	>
		<div class="flex w-full items-center justify-between gap-3">
			<span class="text-xs font-medium uppercase tracking-wide text-ink/55">{t('hero.readoutTitle')}</span>
			<span class="text-xs text-ink/55">
				<span data-when="timezone">{t('hero.locApprox')}</span>
				<span data-when="geolocation" hidden>{t('hero.locPrecise')}</span>
			</span>
		</div>
		<div class="grid w-full grid-cols-3 gap-3 text-center">
			<div>
				<div class="text-[11px] uppercase tracking-wide text-ink/50">{t('mockup.sunrise')}</div>
				<div class="mt-1 text-lg font-semibold tabular-nums text-ink" data-sun="sunrise">--:--</div>
			</div>
			<div>
				<div class="text-[11px] uppercase tracking-wide text-ink/50">{t('mockup.solarNoon')}</div>
				<div class="mt-1 text-lg font-semibold tabular-nums text-ink" data-sun="solarNoon">--:--</div>
			</div>
			<div>
				<div class="text-[11px] uppercase tracking-wide text-ink/50">{t('mockup.sunset')}</div>
				<div class="mt-1 text-lg font-semibold tabular-nums text-ink" data-sun="sunset">--:--</div>
			</div>
		</div>
		<button
			id="loc-btn"
			type="button"
			class="inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-xs font-medium text-ink/80 transition-colors hover:bg-white/5"
		>
			<svg
				width="13"
				height="13"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M12 21s-6-5.686-6-10a6 6 0 1 1 12 0c0 4.314-6 10-6 10z" />
				<circle cx="12" cy="11" r="2" />
			</svg>
			{t('hero.locButton')}
		</button>
	</div>
</section>

<style>
	/* --- 组件根节点 CSS 变量（默认值 = 太阳初始位置右上角） --- */
	#sky-container {
		--sun-x: 72%;
		--sun-y: 22%;
		--shadow-x: -130px;
		--shadow-y: 90px;
		--shadow-blur: 60px;
		--shadow-alpha: 0.5;
	}

	/* --- 太阳：颜色来自 --sun-color，带光晕 --- */
	#draggable-sun {
		left: var(--sun-x);
		top: var(--sun-y);
		background: radial-gradient(circle at 35% 35%, #fff8e1, var(--sun-color) 55%, var(--sun-color) 100%);
		box-shadow:
			0 0 40px 14px color-mix(in srgb, var(--sun-color) 55%, transparent),
			0 0 90px 30px color-mix(in srgb, var(--sun-color) 25%, transparent);
		/* 松手后平滑回归 */
		transition:
			left 0.7s cubic-bezier(0.22, 1, 0.36, 1),
			top 0.7s cubic-bezier(0.22, 1, 0.36, 1);
		/* 触摸拖拽时不滚动页面 */
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
	}

	#draggable-sun.dragging {
		cursor: grabbing;
		/* 拖拽中即时跟随，关闭过渡 */
		transition: none;
	}

	/* --- 太阳驱动的环境光晕：跟随 --sun-x/-y --- */
	#sun-glow {
		background: radial-gradient(
			420px circle at var(--sun-x) var(--sun-y),
			color-mix(in srgb, var(--sun-color) 28%, transparent),
			transparent 60%
		);
		transition: background 0.5s ease;
	}

	/* --- 主屏手机：阴影绑定太阳向量（方向负相关） --- */
	#mockup-object {
		box-shadow:
			var(--shadow-x) var(--shadow-y) var(--shadow-blur) 0
				rgba(var(--shadow-rgb), var(--shadow-alpha));
		transition: box-shadow 0.7s cubic-bezier(0.22, 1, 0.36, 1);
	}

	#mockup-object.no-transition {
		transition: none;
	}
</style>

<script>
	// -------------------------------------------------------------------------
	// 拖拽太阳 → 实时计算阴影向量 + 光晕位置 → 注入 CSS 变量
	// 使用 Pointer Events（统一鼠标 mouse* 与触摸 touch*，现代浏览器全覆盖）
	// -------------------------------------------------------------------------
	(function () {
		const sky = document.getElementById('sky-container');
		const sun = document.getElementById('draggable-sun');
		const mockup = document.getElementById('mockup-object');
		const hint = document.getElementById('drag-hint');
		if (!sky || !sun || !mockup) return;

		// 太阳位置（百分比，相对 sky-container）
		let sunX = parseFloat(getComputedStyle(sky).getPropertyValue('--sun-x')) || 72;
		let sunY = parseFloat(getComputedStyle(sky).getPropertyValue('--sun-y')) || 22;

		// 拖拽状态
		let dragging = false;
		let startPointer = { x: 0, y: 0 };
		let startSun = { x: 0, y: 0 };

		function getCenter(el) {
			const r = el.getBoundingClientRect();
			return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
		}

		// 核心算法：太阳中心 → mockup 中心向量 → 阴影变量
		function updateShadow() {
			const skyRect = sky.getBoundingClientRect();
			const s = getCenter(sun);
			const m = getCenter(mockup);

			const dx = s.x - m.x; // 太阳在右 → dx > 0
			const dy = s.y - m.y; // 太阳在下 → dy > 0
			const dist = Math.hypot(dx, dy);
			const diag = Math.hypot(skyRect.width, skyRect.height);

			// 距离越远 → 阴影越长、越模糊、越淡
			const strength = Math.min(1, dist / (diag * 0.55));
			const k = 0.42; // 阴影长度系数
			const shadowX = -dx * k; // 负相关：太阳在右，阴影投向左
			const shadowY = -dy * k;
			const blur = 18 + dist * 0.09;
			const alpha = 0.22 + strength * 0.38;

			sky.style.setProperty('--shadow-x', shadowX.toFixed(1) + 'px');
			sky.style.setProperty('--shadow-y', shadowY.toFixed(1) + 'px');
			sky.style.setProperty('--shadow-blur', blur.toFixed(1) + 'px');
			sky.style.setProperty('--shadow-alpha', alpha.toFixed(3));
			sky.style.setProperty('--sun-x', sunX.toFixed(1) + '%');
			sky.style.setProperty('--sun-y', sunY.toFixed(1) + '%');
		}

		// 指针位置 → 容器内百分比（以太阳中心为基准）
		function pointerToPct(clientX, clientY) {
			const rect = sky.getBoundingClientRect();
			const half = sun.offsetWidth / 2;
			return {
				x: ((clientX - rect.left - half) / rect.width) * 100,
				y: ((clientY - rect.top - half) / rect.height) * 100,
			};
		}

		function getPointer(e) {
			return { x: e.clientX, y: e.clientY };
		}

		function onDown(e) {
			e.preventDefault();
			dragging = true;
			sun.classList.add('dragging');
			mockup.classList.add('no-transition');
			if (hint) hint.style.opacity = '0';
			startPointer = getPointer(e);
			startSun = { x: sunX, y: sunY };
			window.addEventListener('pointermove', onMove);
			window.addEventListener('pointerup', onUp);
			window.addEventListener('pointercancel', onUp);
		}

		function onMove(e) {
			if (!dragging) return;
			const p = getPointer(e);
			const rect = sky.getBoundingClientRect();
			sunX = startSun.x + ((p.x - startPointer.x) / rect.width) * 100;
			sunY = startSun.y + ((p.y - startPointer.y) / rect.height) * 100;
			sunX = Math.min(100, Math.max(0, sunX));
			sunY = Math.min(100, Math.max(0, sunY));
			sun.style.left = sunX + '%';
			sun.style.top = sunY + '%';
			updateShadow();
		}

		function onUp() {
			dragging = false;
			sun.classList.remove('dragging');
			mockup.classList.remove('no-transition');
			if (hint) hint.style.opacity = '1';
			window.removeEventListener('pointermove', onMove);
			window.removeEventListener('pointerup', onUp);
			window.removeEventListener('pointercancel', onUp);
		}

		// 初始化：位置已由 CSS 变量设定，仅需按当前值计算一次阴影
		sun.style.left = sunX + '%';
		sun.style.top = sunY + '%';
		updateShadow();

		sun.addEventListener('pointerdown', onDown);
		window.addEventListener('resize', updateShadow);
	})();
</script>

<!-- ---------------------------------------------------------------------------
	H — 真实太阳计算：按访客位置计算日出/日落/黄金时刻，
	   驱动全站时段染色、Hero 实时读数、Education 时间轴。
	   全部在设备本地完成，不上送任何位置。
--------------------------------------------------------------------------- -->
<script>
	import { getSunTimes, resolvePhase, formatTime, buildPhases } from '../lib/sun';
	import { estimateLocation, requestPreciseLocation } from '../lib/location';

	function apply(loc) {
		const lang = document.documentElement.lang || 'en';
		const now = new Date();
		const sun = getSunTimes(now, loc.lat, loc.lng);

		// 1) 全站暗色时段随“真实太阳相位”变化（替代纯墙钟近似）
		document.documentElement.dataset.theme = resolvePhase(now, sun);

		// 2) Hero 今日太阳读数
		const setVal = (k, d) => {
			const el = document.querySelector(`[data-sun="${k}"]`);
			if (el) el.textContent = formatTime(d, lang);
		};
		setVal('sunrise', sun.sunrise);
		setVal('solarNoon', sun.solarNoon);
		setVal('sunset', sun.sunset);

		// 3) 位置来源状态切换
		document.querySelectorAll('[data-when]').forEach((el) => {
			el.hidden = el.getAttribute('data-when') !== loc.source;
		});

		// 4) Education 6 段光影时间轴（真实计算覆盖示例）
		buildPhases(sun).forEach((p) => {
			const el = document.querySelector(`[data-phase="${p.key}"]`);
			if (el) el.textContent = `${formatTime(p.start, lang)} – ${formatTime(p.end, lang)}`;
		});
	}

	// 初始：时区粗算（无授权框，立即可用）
	apply(estimateLocation());

	// “使用我的位置”：弹地理授权框 → 精确计算
	const btn = document.getElementById('loc-btn');
	if (btn) {
		btn.addEventListener('click', async () => {
			btn.disabled = true;
			const loc = await requestPreciseLocation();
			apply(loc);
			btn.disabled = false;
		});
	}
</script>
