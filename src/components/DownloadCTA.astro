---
// ---------------------------------------------------------------------------
// DownloadCTA — 底部强引导区：大尺寸 App Store 下载按钮
// ---------------------------------------------------------------------------
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { getAppStoreUrl } from '../lib/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const appStoreUrl = getAppStoreUrl(lang);
---

<section
	id="download"
	class="scroll-mt-20 border-t border-line py-24 text-center"
	style="background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--sun-color) 12%, transparent))"
>
	<div class="mx-auto max-w-3xl px-4 sm:px-6">
		<h2 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{t('cta.title')}</h2>
		<p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-ink/70">
			{t('cta.subtitle')}
		</p>

		<!-- 大号 App Store 下载按钮 -->
		<a
			href={appStoreUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="mt-10 inline-flex items-center gap-3 rounded-2xl bg-black px-8 py-4 text-white shadow-2xl transition-transform duration-300 hover:scale-[1.04] hover:shadow-[0_28px_50px_-18px_rgba(var(--shadow-rgb),0.5)] dark:bg-white dark:text-black"
			aria-label={t('cta.button')}
		>
			<!-- Apple 图标 -->
			<svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
			</svg>
			<span class="text-left leading-tight">
				<span class="block text-[11px] uppercase tracking-wider opacity-80">App Store</span>
				<span class="block text-lg font-semibold">{t('cta.button')}</span>
			</span>
		</a>

		<p class="mt-6 text-xs text-ink/50">{t('hero.cta.sub')}</p>
	</div>
</section>
