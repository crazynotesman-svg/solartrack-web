---
import InteractiveHero from './InteractiveHero.astro';
import Features from './Features.astro';
import Education from './Education.astro';
import FAQ from './FAQ.astro';
import DownloadCTA from './DownloadCTA.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<main>
	<!-- 1. Hero：可拖拽太阳 + 动态阴影 -->
	<InteractiveHero />

	<!-- 1.5 答案前置定义块（GEO：机器可读摘要，供 AI 引擎直接引用） -->
	<section class="mx-auto max-w-3xl px-4 pb-4 text-center sm:px-6">
		<p class="text-base leading-relaxed text-ink/75 sm:text-lg">{t('hero.summary')}</p>
	</section>

	<!-- 2. 功能区：核心功能卡片 -->
	<Features />

	<!-- 3. 科普区：黄金时刻 / 蓝调时刻（Glossary） -->
	<Education />

	<!-- 3.5 常见问题（GEO：可被抽取的 Q&A） -->
	<FAQ />

	<!-- 4. 下载转化区：App Store 大按钮 -->
	<DownloadCTA />
</main>
