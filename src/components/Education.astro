---
// ---------------------------------------------------------------------------
// Education — 当日 6 段光影时间轴（真实 App 的时段列表）+ 真实 Today 截图
// ---------------------------------------------------------------------------
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// 时段（示例时间为无 JS 兜底；客户端会按访客真实位置重新计算并覆盖）
const phases = [
	{ key: 'morning-golden', label: t('education.phase.golden'), time: '06:12 – 07:12', color: 'var(--sun-color)' },
	{ key: 'morning-blue', label: t('education.phase.blue'), time: '07:12 – 07:39', color: '#3b82f6' },
	{ key: 'daylight', label: t('education.phase.daylight'), time: '07:39 – 16:51', color: '#cbd5e1' },
	{ key: 'evening-golden', label: t('education.phase.golden'), time: '16:51 – 17:47', color: 'var(--sun-color)' },
	{ key: 'evening-blue', label: t('education.phase.blue'), time: '17:47 – 18:14', color: '#3b82f6' },
	{ key: 'night', label: t('education.phase.night'), time: '18:14 – 06:12', color: '#475569' },
] as const;
---

<section id="education" class="mx-auto max-w-5xl scroll-mt-20 px-4 py-24 sm:px-6">
	<div class="grid items-center gap-12 md:grid-cols-2">
		<!-- 左：时间轴 -->
		<div>
			<span
				class="inline-flex items-center gap-2 rounded-full border border-line px-4 py-1.5 text-xs font-medium text-ink/80"
			>
				<span class="h-1.5 w-1.5 rounded-full" style="background-color: var(--sun-color)"></span>
				{t('education.title')}
			</span>

			<p class="mt-5 text-lg leading-relaxed text-ink/80">{t('education.lead')}</p>

			<ul class="mt-8 space-y-4 border-l border-line pl-5">
				{
					phases.map((p) => (
						<li class="relative">
							<span
								class="absolute -left-[1.45rem] top-1.5 h-3 w-3 rounded-full ring-4 ring-[color:var(--page-bg)]"
								style={`background-color: ${p.color}`}
								aria-hidden="true"
							/>
							<div class="flex items-baseline justify-between gap-3">
								<span class="font-medium text-ink">{p.label}</span>
								<span class="shrink-0 text-sm tabular-nums text-ink/55" data-phase={p.key}>{p.time}</span>
							</div>
						</li>
					))
				}
			</ul>

			<p class="mt-6 text-xs text-ink/45">{t('education.timelineNote')}</p>
		</div>

		<!-- 右：真实 Today 截图（展示实际时段列表） -->
		<figure
			class="relative mx-auto w-[260px] rounded-[2.4rem] border border-line bg-black p-2 shadow-[0_40px_80px_-30px_rgba(0,0,0,0.9)] sm:w-[300px]"
			role="img"
			aria-label={t('education.imageAlt')}
		>
			<img
				src="/shots/1.webp"
				alt={t('education.imageAlt')}
				class="w-full rounded-[2rem]"
				loading="lazy"
				decoding="async"
			/>
		</figure>
	</div>
</section>
