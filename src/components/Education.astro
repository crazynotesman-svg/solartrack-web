---
// ---------------------------------------------------------------------------
// Education — 摄影光影科普（黄金时刻 / 蓝调时刻）+ 图片占位
// ---------------------------------------------------------------------------
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="education" class="mx-auto max-w-5xl scroll-mt-20 px-4 py-24 sm:px-6">
	<div class="grid items-center gap-12 md:grid-cols-2">
		<!-- 左：科普文字 -->
		<div>
			<span
				class="inline-flex items-center gap-2 rounded-full border border-line px-4 py-1.5 text-xs font-medium text-ink/80"
			>
				<span class="h-1.5 w-1.5 rounded-full" style="background-color: var(--sun-color)"></span>
				{t('education.title')}
			</span>

			<p class="mt-5 text-lg leading-relaxed text-ink/80">{t('education.lead')}</p>

			<!-- 黄金时刻卡片 -->
			<div class="mt-8 rounded-2xl border border-line bg-card p-6 shadow-[0_10px_30px_-20px_rgba(var(--shadow-rgb),0.4)]">
				<div class="flex items-center gap-3">
					<span class="h-3 w-3 rounded-full" style="background-color: var(--sun-color)"></span>
					<h3 class="font-semibold text-ink">{t('education.golden.title')}</h3>
				</div>
				<p class="mt-3 text-sm leading-relaxed text-ink/70">{t('education.golden.desc')}</p>
			</div>

			<!-- 蓝调时刻卡片 -->
			<div class="mt-4 rounded-2xl border border-line bg-card p-6 shadow-[0_10px_30px_-20px_rgba(var(--shadow-rgb),0.4)]">
				<div class="flex items-center gap-3">
					<span class="h-3 w-3 rounded-full" style="background-color: #3b82f6"></span>
					<h3 class="font-semibold text-ink">{t('education.blue.title')}</h3>
				</div>
				<p class="mt-3 text-sm leading-relaxed text-ink/70">{t('education.blue.desc')}</p>
			</div>
		</div>

		<!-- 右：图片占位（后续替换为带 App 滤镜的风景照） -->
		<figure
			class="relative aspect-[4/3] overflow-hidden rounded-3xl border border-line"
			style="background: linear-gradient(160deg, color-mix(in srgb, var(--sun-color) 45%, transparent), color-mix(in srgb, var(--sun-color) 8%, transparent) 60%, rgba(0,0,0,0.18))"
			role="img"
			aria-label={t('education.imageAlt')}
		>
			<!-- 占位太阳 -->
			<div
				class="absolute right-[18%] top-[16%] h-16 w-16 rounded-full"
				style="background: radial-gradient(circle at 35% 35%, #fff8e1, var(--sun-color) 60%); box-shadow: 0 0 60px 20px color-mix(in srgb, var(--sun-color) 40%, transparent)"
				aria-hidden="true"
			></div>

			<!-- 占位山丘 -->
			<svg class="absolute inset-x-0 bottom-0 w-full" viewBox="0 0 600 180" preserveAspectRatio="none" aria-hidden="true">
				<path d="M0 180 L0 120 Q120 60 240 110 Q360 150 460 80 Q520 45 600 100 L600 180 Z" fill="rgba(0,0,0,0.25)" />
			</svg>

			<!-- 占位标注 -->
			<figcaption
				class="absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-black/30 px-4 py-1.5 text-xs text-white/90 backdrop-blur-sm"
			>
				{t('education.imageAlt')}
			</figcaption>
		</figure>
	</div>
</section>
