---
// ---------------------------------------------------------------------------
// PrivacyContent — 极简多语言隐私声明
// ---------------------------------------------------------------------------
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<main class="mx-auto max-w-2xl px-4 py-20 sm:px-6">
	<h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{t('privacy.title')}</h1>
	<p class="mt-2 text-sm text-ink/50">{t('privacy.updated')}</p>

	<!-- 核心声明 -->
	<div
		class="mt-10 rounded-2xl border border-line bg-white/5 p-8"
		style="box-shadow: 0 22px 45px -18px rgba(var(--shadow-rgb), 0.25)"
	>
		<p class="text-lg leading-relaxed text-ink/85">{t('privacy.statement')}</p>
	</div>
</main>

<!-- 页脚 -->
<footer class="border-t border-line py-10 text-center text-sm text-ink/60">
	<p>{t('footer.tagline')}</p>
	<p class="mt-1 text-xs text-ink/40">
		© {new Date().getFullYear()} SolarTrack. {t('footer.rights')}
	</p>
</footer>
