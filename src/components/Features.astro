---
// ---------------------------------------------------------------------------
// Features — 3 个核心功能卡片（CSS Grid）
// 阴影颜色基于主题变量 --shadow-rgb，hover 轻微上浮
// ---------------------------------------------------------------------------
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const features = [
	{
		title: t('feature.ar.title'),
		desc: t('feature.ar.desc'),
		icon: 'ar',
	},
	{
		title: t('feature.alerts.title'),
		desc: t('feature.alerts.desc'),
		icon: 'bell',
	},
	{
		title: t('feature.map.title'),
		desc: t('feature.map.desc'),
		icon: 'globe',
	},
] as const;
---

<section id="features" class="mx-auto max-w-5xl scroll-mt-20 px-4 py-24 sm:px-6">
	<h2 class="text-center text-2xl font-bold tracking-tight text-ink sm:text-3xl">
		{t('nav.features')}
	</h2>
	<p class="mx-auto mt-3 max-w-xl text-center text-ink/60">{t('hero.subtitle')}</p>

	<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
		{
			features.map((f) => (
				<div
					class="group rounded-2xl border border-line bg-white/5 p-7 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_45px_-18px_rgba(var(--shadow-rgb),0.45)]"
				>
					<div
						class="flex h-12 w-12 items-center justify-center rounded-xl"
						style="background: color-mix(in srgb, var(--sun-color) 18%, transparent)"
					>
						{
							f.icon === 'ar' && (
								<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--sun-color)" stroke-width="1.8" aria-hidden="true">
									<path d="M4 8V6a2 2 0 0 1 2-2h2" />
									<path d="M16 4h2a2 2 0 0 1 2 2v2" />
									<path d="M20 16v2a2 2 0 0 1-2 2h-2" />
									<path d="M8 20H6a2 2 0 0 1-2-2v-2" />
									<path d="M12 8l3 4h-2v4h-2v-4H9l3-4z" />
								</svg>
							)
						}
						{
							f.icon === 'bell' && (
								<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--sun-color)" stroke-width="1.8" aria-hidden="true">
									<path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
									<path d="M13.7 21a2 2 0 0 1-3.4 0" />
								</svg>
							)
						}
						{
							f.icon === 'globe' && (
								<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--sun-color)" stroke-width="1.8" aria-hidden="true">
									<circle cx="12" cy="12" r="10" />
									<path d="M2 12h20" />
									<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
								</svg>
							)
						}
					</div>
					<h3 class="mt-5 text-lg font-semibold text-ink">{f.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-ink/70">{f.desc}</p>
				</div>
			))
		}
	</div>
</section>
