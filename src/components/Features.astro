---
// ---------------------------------------------------------------------------
// Features — 4 个核心功能卡片（对应 App 真实截图 2/4/5/3）
// 卡片以真实 App 截图为主视觉，强化可信度
// ---------------------------------------------------------------------------
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const features = [
	{
		key: 'sunpath' as const,
		img: '/shots/2.webp',
		alt: 'Solar Dial — sun path for any date and place',
	},
	{
		key: 'ai' as const,
		img: '/shots/4.webp',
		alt: 'AI Photography Assistant — scene-based suggestions',
	},
	{
		key: 'weather' as const,
		img: '/shots/5.webp',
		alt: 'Weather & Blue Hour Forecast — daily quality score',
	},
	{
		key: 'explore' as const,
		img: '/shots/3.webp',
		alt: 'Explore Worldwide — saved favorite locations',
	},
] as const;
---

<section id="features" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-24 sm:px-6">
	<h2 class="text-center text-2xl font-bold tracking-tight text-ink sm:text-3xl">
		{t('nav.features')}
	</h2>
	<p class="mx-auto mt-3 max-w-xl text-center text-ink/60">{t('hero.subtitle')}</p>

	<div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
		{
			features.map((f) => (
				<div class="group overflow-hidden rounded-2xl border border-line bg-card shadow-[0_10px_30px_-20px_rgba(0,0,0,0.6)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_45px_-18px_rgba(0,0,0,0.7)]">
					<div class="aspect-[4/5] overflow-hidden bg-black/40">
						<img
							src={f.img}
							alt={f.alt}
							class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<div class="p-5">
						<div
							class="flex h-9 w-9 items-center justify-center rounded-lg"
							style="background: color-mix(in srgb, var(--sun-color) 18%, transparent)"
						>
							<span class="h-2.5 w-2.5 rounded-full" style="background-color: var(--sun-color)" />
						</div>
						<h3 class="mt-4 text-base font-semibold text-ink">{t(`feature.${f.key}.title`)}</h3>
						<p class="mt-2 text-sm leading-relaxed text-ink/70">{t(`feature.${f.key}.desc`)}</p>
					</div>
				</div>
			))
		}
	</div>
</section>
