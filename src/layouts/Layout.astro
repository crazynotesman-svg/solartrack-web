---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/ui';

interface Props {
	title?: string;
	description?: string;
	lang?: Lang;
}

const { title, description } = Astro.props;
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang} data-theme="noon">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!--
			FOUC 防护（关键渲染路径）：
			1) 内联 <style> 在外部 CSS 加载前就给 <html> 上主题背景色/前景色，
			  避免深色系统/深色浏览器下首屏出现“深色画布 → 浅色页面”的闪烁。
			2) 内联 <script> 按本地时间设置 <html data-theme>，并同步 color-scheme。
			时段划分：6–10 Morning | 10–16 Noon | 16–19 Golden Hour | 19–6 Night
		-->
		<style is:inline>
			:root,
			[data-theme='noon'] {
				--page-bg: #0f172a;
				--page-text: #e2e8f0;
				--sun-color: #ffb703;
			}
			[data-theme='morning'] {
				--page-bg: #161b22;
				--page-text: #dbe2ea;
				--sun-color: #ffd166;
			}
			[data-theme='golden-hour'] {
				--page-bg: #1c140d;
				--page-text: #f3e3d0;
				--sun-color: #f77f00;
			}
			[data-theme='night'] {
				--page-bg: #0b1220;
				--page-text: #e2e8f0;
				--sun-color: #f4f1de;
			}
			html {
				background-color: var(--page-bg);
				color: var(--page-text);
				/* 主题切换的平滑过渡：缓慢淡入淡出，而非瞬间跳变 */
				transition:
					background-color 1.4s ease,
					color 1.4s ease;
			}
		</style>
		<script is:inline>
			(function () {
				var hour = new Date().getHours();
				var theme;
				if (hour >= 6 && hour < 10) theme = 'morning';
				else if (hour >= 10 && hour < 16) theme = 'noon';
				else if (hour >= 16 && hour < 19) theme = 'golden-hour';
				else theme = 'night';
				var d = document.documentElement;
				/* 全站暗色基底：color-scheme 始终为 dark，避免浅色画布闪烁 */
				d.style.colorScheme = 'dark';
				/*
				 * 首帧：<html> 已通过内联 style 着上为暗色基底，不会闪浅色画布。
				 * 下一帧再把 data-theme 切到真实时段 → 触发 1.4s 缓慢过渡（暗色随时间微染）。
				 */
				requestAnimationFrame(function () {
					d.setAttribute('data-theme', theme);
				});
			})();
		</script>
		<link rel="icon" type="image/png" href="/icon-256.png" />
		<link rel="apple-touch-icon" href="/icon-256.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title ?? t('site.title')}</title>
		<SEO title={title} description={description} />
	</head>
	<body class="min-h-dvh antialiased">
		<slot />
	</body>
</html>
